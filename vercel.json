{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/server_improved.js"
    },
    {
      "source": "/(.*)",
      "destination": "/server_improved.js"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}